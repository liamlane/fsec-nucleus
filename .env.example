# ════════════════════════════════════════════════════════════════════
# Nucleus environment configuration
#
# Copy this file to .env and fill in the values.
# This file is committed; .env is in .gitignore and must NEVER be committed.
# ════════════════════════════════════════════════════════════════════

# ── Database ─────────────────────────────────────────────────────────
# Default values are reasonable; only the password is required.
POSTGRES_DB=nucleus
POSTGRES_USER=nucleus
POSTGRES_PASSWORD=change_me_to_a_strong_password

# ── Auth ─────────────────────────────────────────────────────────────
# Generate JWT_SECRET with: openssl rand -hex 32
JWT_SECRET=change_me_run_openssl_rand_hex_32

# Generate PIN_HASH by running once with this var empty, then POST your
# desired PIN to /api/auth/setup-pin (must be authenticated — log in
# first using any PIN, since empty PIN_HASH means anything works).
# Copy the returned hash here, then restart the backend.
PIN_HASH=

# ── App ──────────────────────────────────────────────────────────────
# Host port nginx exposes the app on.
APP_PORT=8080

# ── Optional ─────────────────────────────────────────────────────────
# Comma-separated list of origins permitted by CORS.
# Leave empty (or unset) to allow all origins — fine for same-origin LAN deployment.
# ALLOWED_ORIGINS=https://nucleus.example.com,https://other.example.com

# Set to 'true' to log every HTTP request to app_logs.
# LOG_REQUESTS=true
